{
  "kind": "collectionType",
  "collectionName": "editions",
  "info": {
    "singularName": "edition",
    "pluralName": "editions",
    "displayName": "Edition",
    "description": "Editions annuelles de l'action"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "annee": {
      "type": "integer",
      "required": true,
      "unique": true
    },
    "affiche": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "date_action": {
      "type": "date"
    },
    "montant_collecte": {
      "type": "decimal"
    },
    "description": {
      "type": "blocks"
    },
    "partenaires": {
      "type": "component",
      "repeatable": true,
      "component": "elements.partenaire"
    },
    "article_recap": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::article.article"
    },
    "galeries": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::galerie.galerie",
      "mappedBy": "edition"
    }
  }
}
