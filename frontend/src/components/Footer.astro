---
const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-white py-12">
  <div class="container mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8">
    <div>
      <h3 class="text-xl font-bold mb-4 text-rose-500">Une Rose Un Espoir</h3>
      <p class="text-gray-400">
        Ensemble contre le cancer.
      </p>
    </div>
    
    <div>
      <h4 class="font-bold mb-4">Liens Utiles</h4>
      <ul class="space-y-2">
        <li><a href="/mentions-legales" class="text-gray-400 hover:text-white">Mentions légales</a></li>
        <li><a href="/contact" class="text-gray-400 hover:text-white">Contact</a></li>
        <li><a href="https://www.ligue-cancer.net/" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white">Ligue contre le cancer</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-bold mb-4">Suivez-nous</h4>
      <div class="flex gap-4">
        <!-- Social Icons placeholder -->
        <a href="#" class="text-gray-400 hover:text-white">Facebook</a>
        <a href="#" class="text-gray-400 hover:text-white">Instagram</a>
      </div>
    </div>
  </div>
  <div class="container mx-auto px-4 mt-8 pt-8 border-t border-gray-800 text-center text-gray-500">
    <p>&copy; {currentYear} Une Rose Un Espoir. Tous droits réservés.</p>
  </div>
</footer>
