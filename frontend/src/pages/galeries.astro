---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import fetchApi from '../lib/strapi';
import { getImageUrl } from '../lib/helpers';

// Fetch all published galeries with their medias and edition
let galeries: any[] = [];
let strapiOnline = true;
try {
  galeries = await fetchApi<any[]>({
    endpoint: 'galeries',
    query: {
      'sort': 'createdAt:desc',
      'populate': '*',
    },
    wrappedByKey: 'data',
  }) ?? [];
} catch (e) {
  strapiOnline = false;
}

// Transform galeries data for the lightbox
function getGalerieImages(galerie: any): { src: string; alt: string }[] {
  if (!galerie.medias) return [];
  const medias = Array.isArray(galerie.medias) ? galerie.medias : [galerie.medias];
  return medias
    .filter((m: any) => m.mime?.startsWith('image/'))
    .map((m: any) => ({
      src: getImageUrl(m) ?? '',
      alt: galerie.titre,
    }))
    .filter((img: { src: string }) => img.src);
}

function getYoutubeUrls(galerie: any): string[] {
  if (!galerie.youtube_urls) return [];
  if (Array.isArray(galerie.youtube_urls)) return galerie.youtube_urls;
  return [];
}

function getYoutubeId(url: string): string {
  const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/))([^&?/]+)/);
  return match ? match[1] : '';
}
---

<Layout title="Galeries - Une Rose Un Espoir">
  <div class="container mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold font-heading mb-4 text-rose-600">Galeries Photos</h1>
    <p class="text-gray-500 mb-12">Revivez les moments forts de nos éditions en images et en vidéo.</p>

    {galeries.length > 0 ? (
      galeries.map((galerie: any) => {
        const images = getGalerieImages(galerie);
        const videos = getYoutubeUrls(galerie);
        return (
          <section class="mb-16">
            <h2 class="text-2xl font-bold font-heading mb-6 text-gray-800 border-b pb-3">
              {galerie.titre}
            </h2>
            {images.length > 0 || videos.length > 0 ? (
              <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
                {images.map((img, i) => (
                  <button
                    class="lightbox-thumb aspect-square overflow-hidden rounded-lg cursor-pointer border-0 p-0 bg-transparent group"
                    data-src={img.src}
                    data-alt={img.alt}
                    data-index={i}
                    data-total={images.length}
                    data-type="image"
                  >
                    <img
                      src={img.src}
                      alt={img.alt}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200"
                      loading="lazy"
                    />
                  </button>
                ))}
                {videos.map((url) => {
                  const ytId = getYoutubeId(url);
                  return (
                    <button
                      class="lightbox-thumb aspect-square overflow-hidden rounded-lg cursor-pointer border-0 p-0 bg-gray-900 relative group"
                      data-src={`https://www.youtube.com/embed/${ytId}`}
                      data-type="video"
                    >
                      <img
                        src={`https://img.youtube.com/vi/${ytId}/mqdefault.jpg`}
                        alt="Vidéo YouTube"
                        class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity"
                        loading="lazy"
                      />
                      <div class="absolute inset-0 flex items-center justify-center">
                        <span class="text-white text-5xl drop-shadow-lg">▶</span>
                      </div>
                    </button>
                  );
                })}
              </div>
            ) : (
              <p class="text-gray-400 py-8 text-center">Aucun média dans cette galerie.</p>
            )}
          </section>
        );
      })
    ) : (
      <div class="text-center py-16">
        <span class="text-6xl block mb-4">📷</span>
        <p class="text-gray-500">
          {strapiOnline ? "Aucune galerie publiée pour le moment." : "⚠️ Impossible de charger les galeries. Vérifiez que le serveur est en ligne."}
        </p>
      </div>
    )}
  </div>

  <!-- Lightbox modal -->
  <div id="lightbox-modal" class="fixed inset-0 bg-black/90 z-50 items-center justify-center p-4 hidden">
    <button id="lightbox-close" class="absolute top-4 right-4 text-white text-3xl hover:text-gray-300 z-50 bg-transparent border-0 cursor-pointer" aria-label="Fermer">✕</button>

    <!-- Image view -->
    <div id="lightbox-image-view" class="flex items-center justify-center w-full h-full hidden">
      <button id="lightbox-prev" class="absolute left-4 text-white text-4xl hover:text-gray-300 disabled:opacity-30 bg-transparent border-0 cursor-pointer z-50" aria-label="Précédent">‹</button>
      <img id="lightbox-img" src="" alt="" class="max-h-[85vh] max-w-[90vw] object-contain rounded" />
      <button id="lightbox-next" class="absolute right-4 text-white text-4xl hover:text-gray-300 disabled:opacity-30 bg-transparent border-0 cursor-pointer z-50" aria-label="Suivant">›</button>
      <div id="lightbox-counter" class="absolute bottom-4 text-white text-sm"></div>
    </div>

    <!-- Video view -->
    <div id="lightbox-video-view" class="w-full max-w-4xl aspect-video hidden">
      <iframe id="lightbox-iframe" src="" class="w-full h-full rounded-lg" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen title="Vidéo YouTube"></iframe>
    </div>
  </div>
</Layout>

<script>
  const modal = document.getElementById('lightbox-modal')!;
  const closeBtn = document.getElementById('lightbox-close')!;
  const imageView = document.getElementById('lightbox-image-view')!;
  const videoView = document.getElementById('lightbox-video-view')!;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const iframe = document.getElementById('lightbox-iframe') as HTMLIFrameElement;
  const prevBtn = document.getElementById('lightbox-prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('lightbox-next') as HTMLButtonElement;
  const counter = document.getElementById('lightbox-counter')!;

  // Collect all image thumbs in order for navigation
  let currentIndex = 0;
  let currentImages: { src: string; alt: string }[] = [];

  function openModal() {
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    imageView.classList.add('hidden');
    videoView.classList.add('hidden');
    iframe.src = '';
    document.body.style.overflow = '';
  }

  function showImage(index: number) {
    if (index < 0 || index >= currentImages.length) return;
    currentIndex = index;
    img.src = currentImages[index].src;
    img.alt = currentImages[index].alt;
    prevBtn.disabled = index === 0;
    nextBtn.disabled = index === currentImages.length - 1;
    counter.textContent = `${index + 1} / ${currentImages.length}`;
    imageView.classList.remove('hidden');
    videoView.classList.add('hidden');
  }

  function showVideo(embedUrl: string) {
    iframe.src = embedUrl;
    videoView.classList.remove('hidden');
    imageView.classList.add('hidden');
  }

  // Attach click to all thumbnails
  document.querySelectorAll('.lightbox-thumb').forEach((btn) => {
    btn.addEventListener('click', () => {
      const type = btn.getAttribute('data-type');
      const src = btn.getAttribute('data-src') || '';

      if (type === 'video') {
        openModal();
        showVideo(src);
      } else {
        // Gather all image thumbnails from the same section
        const section = btn.closest('section');
        if (section) {
          currentImages = Array.from(section.querySelectorAll('.lightbox-thumb[data-type="image"]')).map((el) => ({
            src: el.getAttribute('data-src') || '',
            alt: el.getAttribute('data-alt') || '',
          }));
          const index = parseInt(btn.getAttribute('data-index') || '0', 10);
          openModal();
          showImage(index);
        }
      }
    });
  });

  closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  prevBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    showImage(currentIndex - 1);
  });
  nextBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    showImage(currentIndex + 1);
  });
  img.addEventListener('click', (e) => e.stopPropagation());

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (modal.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeModal();
    if (e.key === 'ArrowLeft') showImage(currentIndex - 1);
    if (e.key === 'ArrowRight') showImage(currentIndex + 1);
  });
</script>
