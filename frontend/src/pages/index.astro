---
import Layout from '../layouts/Layout.astro';
import fetchApi from '../lib/strapi';

let articles = [];
try {
  // Example fetch, assuming 'articles' endpoint exists and is public
  // articles = await fetchApi<any[]>({ endpoint: 'articles', wrappedByKey: 'data' });
} catch (e) {
  console.log('Strapi offline or not reachable, using placeholders.');
}
---

<Layout title="Une Rose Un Espoir - Accueil">
  <!-- Hero Section -->
  <section class="relative bg-rose-600 text-white overflow-hidden">
    <div class="absolute inset-0 bg-black/20"></div>
    <div class="container mx-auto px-4 py-24 relative z-10 text-center">
      <h1 class="text-4xl md:text-6xl font-bold font-heading mb-6">
        Une Rose, Un Espoir
      </h1>
      <p class="text-xl md:text-2xl mb-8 max-w-2xl mx-auto">
        Les motards s'unissent contre le cancer. Rejoignez-nous pour la prochaine édition.
      </p>
      <a href="/action" class="inline-block bg-white text-rose-600 font-bold py-3 px-8 rounded-full hover:bg-gray-100 transition-colors">
        En savoir plus
      </a>
    </div>
  </section>

  <!-- Edition Courante Teaser (Static placeholder for now) -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="md:w-1/2">
          <div class="bg-gray-200 aspect-[3/4] rounded-lg flex items-center justify-center text-gray-500">
            Affiche Edition (Placeholder)
          </div>
        </div>
        <div class="md:w-1/2">
          <h2 class="text-3xl font-bold font-heading mb-4 text-gray-800">Prochaine Édition 2026</h2>
          <p class="text-lg text-gray-600 mb-6">
            Préparez-vous pour un week-end de solidarité et de partage. Nos motards sillonneront les routes pour collecter des dons contre une rose.
          </p>
          <div class="flex gap-4">
            <div class="bg-rose-50 p-4 rounded-lg text-center min-w-[100px]">
              <span class="block text-2xl font-bold text-rose-600">25</span>
              <span class="text-sm text-gray-600">Avril</span>
            </div>
            <div class="bg-rose-50 p-4 rounded-lg text-center min-w-[100px]">
              <span class="block text-2xl font-bold text-rose-600">26</span>
              <span class="text-sm text-gray-600">Avril</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Dernières Actualités (Placeholder) -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl font-bold font-heading mb-12 text-center text-gray-800">Dernières Actualités</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {[1, 2, 3].map((i) => (
          <article class="bg-white rounded-lg shadow-sm overflow-hidden hover:shadow-md transition-shadow">
            <div class="h-48 bg-gray-200"></div>
            <div class="p-6">
              <span class="text-xs font-bold text-rose-600 uppercase tracking-wider">Actualité</span>
              <h3 class="text-xl font-bold mt-2 mb-2 font-heading">Titre de l'article {i}</h3>
              <p class="text-gray-600 text-sm line-clamp-3">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
              </p>
              <a href="#" class="inline-block mt-4 text-rose-600 font-medium hover:underline">Lire la suite &rarr;</a>
            </div>
          </article>
        ))}
      </div>
      <div class="text-center mt-12">
        <a href="/actualites" class="inline-block border-2 border-rose-600 text-rose-600 font-bold py-2 px-6 rounded-full hover:bg-rose-600 hover:text-white transition-colors">
          Toutes les actualités
        </a>
      </div>
    </div>
  </section>
</Layout>
