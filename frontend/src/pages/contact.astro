---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact - Une Rose Un Espoir">
  <div class="container mx-auto px-4 py-12 max-w-2xl">
    <h1 class="text-4xl font-bold font-heading mb-4 text-rose-600">Contactez-nous</h1>
    <p class="text-gray-500 mb-8">
      Une question, une proposition de partenariat ou simplement envie de nous rejoindre ?
      Remplissez le formulaire ci-dessous et nous vous répondrons rapidement.
    </p>

    <!-- Success message (hidden by default) -->
    <div id="contact-success" class="bg-green-50 border border-green-200 rounded-lg p-8 text-center hidden">
      <span class="text-4xl block mb-4">✅</span>
      <h2 class="text-xl font-bold text-green-800 mb-2">Message envoyé !</h2>
      <p class="text-green-700">
        Merci pour votre message. Nous vous répondrons dans les plus brefs délais.
      </p>
      <button
        id="contact-reset"
        class="mt-6 text-rose-600 hover:underline font-medium cursor-pointer"
      >
        Envoyer un autre message
      </button>
    </div>

    <!-- Contact form -->
    <form id="contact-form" class="space-y-6">
      <div>
        <label for="name" class="block text-sm font-medium text-gray-700 mb-1">
          Nom <span class="text-rose-500">*</span>
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="block w-full rounded-lg border border-gray-300 px-4 py-3 shadow-sm focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 outline-none transition-colors"
          placeholder="Votre nom"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
          Email <span class="text-rose-500">*</span>
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="block w-full rounded-lg border border-gray-300 px-4 py-3 shadow-sm focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 outline-none transition-colors"
          placeholder="votre@email.com"
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-gray-700 mb-1">
          Message <span class="text-rose-500">*</span>
        </label>
        <textarea
          id="message"
          name="message"
          rows="5"
          required
          class="block w-full rounded-lg border border-gray-300 px-4 py-3 shadow-sm focus:border-rose-500 focus:ring-2 focus:ring-rose-500/20 outline-none transition-colors resize-y"
          placeholder="Votre message..."
        ></textarea>
      </div>

      <!-- Error message -->
      <div id="contact-error" class="bg-red-50 border border-red-200 rounded-lg p-4 text-red-700 text-sm hidden">
      </div>

      <button
        type="submit"
        id="contact-submit"
        class="bg-rose-600 text-white font-bold py-3 px-8 rounded-lg hover:bg-rose-700 transition-colors disabled:opacity-50 disabled:cursor-wait flex items-center gap-2 cursor-pointer"
      >
        Envoyer le message
      </button>
    </form>
  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successDiv = document.getElementById('contact-success')!;
  const errorDiv = document.getElementById('contact-error')!;
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;
  const resetBtn = document.getElementById('contact-reset')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorDiv.classList.add('hidden');
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="inline-block w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></span> Envoi en cours...';

    const formData = new FormData(form);
    const body = {
      name: formData.get('name'),
      email: formData.get('email'),
      message: formData.get('message'),
    };

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });

      if (res.ok) {
        form.classList.add('hidden');
        successDiv.classList.remove('hidden');
        form.reset();
      } else {
        const data = await res.json();
        errorDiv.textContent = '⚠️ ' + (data.error || 'Une erreur est survenue.');
        errorDiv.classList.remove('hidden');
      }
    } catch {
      errorDiv.textContent = '⚠️ Impossible de contacter le serveur.';
      errorDiv.classList.remove('hidden');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Envoyer le message';
    }
  });

  resetBtn.addEventListener('click', () => {
    successDiv.classList.add('hidden');
    form.classList.remove('hidden');
  });
</script>
