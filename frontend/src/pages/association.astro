---
import Layout from '../layouts/Layout.astro';
---

<Layout title="L'Association - Une Rose Un Espoir">
  <section class="container mx-auto px-4 py-12 max-w-3xl">
    <h1 class="text-4xl font-bold font-heading mb-8 text-rose-600">L'Association</h1>
    <div class="prose prose-lg max-w-none">
      <p>
        <strong>Une Rose Un Espoir</strong> est une action de solidarité organisée chaque année à travers la France
        dans le cadre de la <a href="https://www.ligue-cancer.net/" target="_blank" rel="noopener noreferrer" class="text-rose-600 hover:underline">Ligue contre le cancer</a>.
      </p>
      <p>
        Cette page sera enrichie avec du contenu depuis le panneau d'administration Strapi.
      </p>
    </div>
  </section>
</Layout>
