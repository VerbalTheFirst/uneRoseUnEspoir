---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Secteurs - Une Rose Un Espoir">
  <section class="container mx-auto px-4 py-12 max-w-3xl">
    <h1 class="text-4xl font-bold font-heading mb-8 text-rose-600">Nos Secteurs</h1>
    <div class="prose prose-lg max-w-none">
      <p>
        L'action "Une Rose Un Espoir" est organisée par secteurs géographiques.
        Retrouvez ici les informations sur le secteur le plus proche de chez vous.
      </p>
      <p>
        Cette page sera enrichie avec du contenu depuis le panneau d'administration Strapi.
      </p>
    </div>
  </section>
</Layout>
